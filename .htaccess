# =================================================================
# PORTAL CYBERSECURITY
# =================================================================
# OBS: Loopias servrar saknar mod_filter. Använd ALDRIG
# AddOutputFilterByType här — gzip/Brotli är redan påslaget.
# Allt nedan är inkapslat i <IfModule> så att en saknad modul ger
# tyst degradering i stället för HTTP 500.
# =================================================================

# ---------- 1. Ingen kataloglistning ----------
# Loopia listar annars innehållet i /js/, /css/ och /bilder/.
Options -Indexes

# ---------- 2. Egen felsida ----------
ErrorDocument 400 /404.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 405 /404.html
ErrorDocument 410 /404.html
ErrorDocument 500 /404.html

# ---------- 3. Rotfallback för ikoner ----------
# Alla bilder ligger i /bilder/, men vissa klienter hämtar dessa
# sökvägar direkt från domänroten utan att läsa HTML-taggarna:
# webbläsare och RSS-läsare tar /favicon.ico, iOS tar
# /apple-touch-icon.png. Utan raderna nedan blir det 404 i loggen. Lägger även till eventuella /X.html sidor
<IfModule mod_alias.c>
  RedirectMatch 301 ^/favicon\.ico$ https://portalcs.se/bilder/favicon.ico
  RedirectMatch 301 ^/favicon\.svg$ https://portalcs.se/bilder/favicon.svg
  RedirectMatch 301 ^/apple-touch-icon(-precomposed)?\.png$ https://portalcs.se/bilder/apple-touch-icon.png

  RedirectMatch 301 ^/og-image\.png$ https://portalcs.se/bilder/og-image.png
  RedirectMatch 301 ^/(integritetspolicy|leverantorsinfo|sarbarhetsrapportering)$ https://portalcs.se/$1.html
  RedirectMatch 404 ^/(js|css|bilder)/?$
</IfModule>

# ---------- 4. Teckenkodning ----------
AddDefaultCharset UTF-8
AddType text/plain .txt


# ---------- 5. Säkerhetsheaders ----------
<IfModule mod_headers.c>
  # Full CSP. Skillnaden mot meta-taggen är frame-ancestors, som
  # bara kan sättas via HTTP-header.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'none'; img-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; manifest-src 'self'; worker-src 'none'; media-src 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types portal-html"

  Header always set X-Frame-Options "DENY"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=(), browsing-topics=(), attribution-reporting=(), join-ad-interest-group=(), run-ad-auction=(), private-state-token-issuance=(), private-state-token-redemption=(), bluetooth=(), serial=(), hid=(), idle-detection=(), local-fonts=(), display-capture=(), screen-wake-lock=(), window-management=(), compute-pressure=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  
  # HSTS — (24 timmar). Se intern README-LOOPIA.md innan det höjs.
  # includeSubDomains och preload är MEDVETET utelämnade eftersom
  # subdomäner planeras. Läs varningen innan de läggs till.
  Header always set Strict-Transport-Security "max-age=86400"

  # Ta bort headers som avslöjar plattformsdetaljer.
  Header always unset X-Powered-By
  Header unset X-Powered-By

  Header always unset X-Loopia-Node
  Header unset X-Loopia-Node

</IfModule>

# ---------- 6. Indexering: bara sidorna i sitemap.xml ----------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|webmanifest|json)$">
    Header always set X-Robots-Tag "noindex"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|webmanifest|json|txt|png|ico)$">
    Header always set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# security.txt ska serveras som ren text.
<Files "security.txt">
  ForceType text/plain
  <IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex"
  </IfModule>
</Files>

# ---------- 7. Uppladdning och nekande ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} (^|/)\.(?!well-known(/|$))
  RewriteRule ^ - [R=404,L]

  # Utvecklingsfiler utan inledande punkt.
  RewriteRule (^|/)(_mall\.html|README\.md|SECURITY\.md|_config\.yml|_headers|\.nojekyll)$ - [R=404,L]

  # artiklar bor i artiklar.html; mappen artiklar/ innehåller bara artiklarna.
  # Måste ligga före katalogregeln, annars fångar -d den och ger 404.
  RewriteRule ^artiklar/?$ https://portalcs.se/artiklar.html [R=301,L]

  # Kataloger (även framtida) svarar 404 i stället för listning eller omdirigering.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [R=404,L]
</IfModule>

# ---------- 8. Cachning ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
